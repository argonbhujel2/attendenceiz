# Copy this file to .env and fill in real values.
# Never commit the real .env file.

SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Leave empty to use local SQLite (attendance_local.db) for development.
# For production, paste your Neon connection string:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=

# First admin account (created automatically on first start)
ADMIN_USERNAME=argon
ADMIN_PASSWORD=change-this-password

FLASK_ENV=development
FLASK_APP=wsgi.py
